# Server configuration. Copy to .env for local, non-Docker runs — the server
# loads it from the working directory on startup. A real environment variable
# always wins over a value here, and a missing .env is not an error, so under
# Docker Compose this file is simply unused.
#
# These belong to the SERVER only. The CLI never reads a database URL from any
# source — if a client-side setting looks like a connection string, that is a
# bug. SPEC.md §6.1, AC-65.

CREWLIST_BIND=127.0.0.1:8787
CREWLIST_POSTGRES_URL=postgres://crewlist:crewlist@localhost:5432/crewlist
CREWLIST_MONGO_URL=mongodb://localhost:27017

RUST_LOG=crewlist_server=debug,crewlist_store=debug,tower_http=info
